{
    "$id": "config.schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "description": "Storage plugin configuration",
    "required": [
        "cassandra",
        "storageConfig"
    ],
    "additionalProperties": false,
    "properties": {
        "cassandra": {
            "type": "object",
            "description": "Apache Cassandra configuration",
            "required": [
                "hosts",
                "username",
                "password",
                "keyspace",
                "datacenter"
            ],
            "additionalProperties": false,
            "properties": {
                "hosts": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "format": "hostname"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                },
                "username": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "keyspace": {
                    "type": "string"
                },
                "datacenter": {
                    "type": "string"
                }
            }
        },
        "storageConfig": {
            "type": "object",
            "properties": {
                "refreshInterval": {
                    "type": "integer",
                    "description": "Interval (in milliseconds) in which to refresh storage config from Core API (0 = disable)"
                }
            },
            "additionalProperties": false,
            "default": {
                "refreshInterval": 600000
            }
        },
        "cluster": {
            "type": "object",
            "description": "Storage node cluster config",
            "required": [
                "clusterSize",
                "myIndexInCluster"
            ],
            "additionalProperties": false,
            "properties": {
                "clusterAddress": {
                    "type": "string"
                },
                "clusterSize": {
                    "type": "number"
                },
                "myIndexInCluster": {
                    "type": "number"
                }
            },
            "default": {
                "clusterSize": 1,
                "myIndexInCluster": 0
            }
        },
        "bucket": {
            "type": "object",
            "description": "Cassandra bucket sizing. Smaller buckets keep partitions small under sustained binary ingest.",
            "additionalProperties": false,
            "properties": {
                "maxBucketSize": {
                    "type": "integer",
                    "description": "Bytes stored in a bucket before a new one is opened",
                    "minimum": 1,
                    "default": 8388608
                },
                "maxBucketRecords": {
                    "type": "integer",
                    "description": "Messages stored in a bucket before a new one is opened",
                    "minimum": 1,
                    "default": 500000
                },
                "checkFullBucketsTimeout": {
                    "type": "integer",
                    "description": "Interval (in milliseconds) between checks for full buckets",
                    "minimum": 1,
                    "default": 250
                }
            },
            "default": {}
        },
        "batch": {
            "type": "object",
            "description": "Cassandra write batching",
            "additionalProperties": false,
            "properties": {
                "logErrors": {
                    "type": "boolean",
                    "description": "Log each failed batch insert (they are retried silently otherwise)",
                    "default": true
                }
            },
            "default": {}
        },
        "signedReads": {
            "type": "object",
            "description": "Require a signed request to read the streams of a gated Pombo channel (all but the admin stream).",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                }
            },
            "default": {}
        },
        "retention": {
            "type": "object",
            "description": "Automatic retention: delete stored data past each stream's storageDays, with no external process. In a cluster it runs only on the node with index 0.",
            "additionalProperties": false,
            "properties": {
                "enabled": { "type": "boolean", "default": true },
                "intervalHours": { "type": "number", "minimum": 1, "default": 6 },
                "graceDays": { "type": "number", "minimum": 0, "default": 7 },
                "abortFractionPercent": { "type": "number", "minimum": 1, "maximum": 100, "default": 30 },
                "bucketDeleteLimit": { "type": "integer", "minimum": 1, "default": 100000 },
                "rowDeleteLimit": { "type": "integer", "minimum": 1, "default": 200000 }
            },
            "default": {}
        },
        "apiAuthentication": {
            "$ref": "definitions.schema.json#/definitions/apiAuthenticationOverride"
        }
    }
}
